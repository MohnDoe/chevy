generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  discordId           String   @unique
  hevyUsername        String?  @unique
  hevyProfilePrivate  Boolean  @default(false)
  isFollowingHevyBot  Boolean  @default(false)
  isFollowedByHevyBot Boolean  @default(false)
  hevyApiKey          String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastInteraction     DateTime @default(now())

  OwnedServers Server[]

  Shares Share[]

  Workouts Workout[]
}

model Workout {
  id                 String   @id @default(uuid()) @db.Uuid
  hevyWorkoutId      String
  hevyWorkoutShortId String
  createdAt          DateTime
  User               User     @relation(fields: [userId], references: [id])
  userId             String

  Shares Share[]
}

model Server {
  id        String @id @default(uuid()) @db.Uuid
  discordId String @unique
  settings  Json?

  Owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String
}

enum ShareReason {
  commandUsed
  autoShared
}

model Share {
  id          String      @id @default(uuid()) @db.Uuid
  Workout     Workout     @relation(fields: [workoutId], references: [id])
  workoutId   String
  channelId   String
  channelType String
  reason      ShareReason
  sharedBy    User?       @relation(fields: [sharerId], references: [id]) // null if bot
  sharerId    String?
  createdAt   DateTime    @default(now())
}
