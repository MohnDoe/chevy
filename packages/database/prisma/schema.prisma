generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  discordId       String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastInteraction DateTime @default(now())

  hevyVerification HevyVerification?

  Shares Share[]

  Workouts Workout[]

  UserAutoShareConfig UserAutoShareConfig[]
}

enum UserVerificationStatus {
  verified
  pending
}

model HevyVerification {
  id                      String                 @id @unique @default(cuid())
  lastCheck               DateTime?
  workoutId               String
  verificationCode        String                 @unique
  status                  UserVerificationStatus @default(pending)
  User                    User                   @relation(fields: [userDiscordId], references: [discordId])
  userDiscordId           String                 @unique
  username                String
  privateProfile          Boolean                @default(false)
  followedByBot           Boolean                @default(false)
  privateInstructionsSent Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workout {
  id String @id @default(uuid())

  hevyWorkoutId      String   @unique
  hevyWorkoutShortId String   @unique
  createdAt          DateTime

  User   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid

  Shares Share[]
}

model Server {
  guildId String @id @unique

  ServerAutoShareConfig ServerAutoShareConfig?
  UserAutoShareConfig   UserAutoShareConfig[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum AutoShareWorkoutFormat {
  line
  compact
  detailed
}

model ServerAutoShareConfig {
  Server  Server @relation(fields: [guildId], references: [guildId])
  guildId String @id @unique

  enabled       Boolean                @default(false)
  channelId     String?
  workoutFormat AutoShareWorkoutFormat
  updatedAt     DateTime               @updatedAt
  createdAt     DateTime               @default(now())
}

model UserAutoShareConfig {
  User    User   @relation(fields: [userId], references: [id])
  userId  String @db.Uuid
  Server  Server @relation(fields: [guildId], references: [guildId])
  guildId String

  enabled Boolean @default(false)

  lastWorkoutCheck DateTime?
  lastWorkoutId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, guildId])
}

enum ShareReason {
  commandUsed
  autoShared
}

model Share {
  id String @id @default(uuid())

  Workout   Workout @relation(fields: [workoutId], references: [id])
  workoutId String

  channelId   String
  channelType Int
  format      String
  commandUsed String?
  reason      ShareReason

  sharedBy User?   @relation(fields: [sharerId], references: [id]) // null if bot
  sharerId String? @db.Uuid

  createdAt DateTime @default(now())
}
