generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @default(uuid()) @db.Uuid
  discordId            String    @unique
  hevyUsername         String?   @unique
  hevyProfilePrivate   Boolean   @default(false)
  isFollowedByHevyBot  Boolean   @default(false)
  lastInteraction      DateTime  @default(now())
  lastBotFollowRequest DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hevyUserVerifications HevyUserVerification[]

  @@unique([discordId, hevyUsername])
}

enum UserVerificationStatus {
  verified
  pending
}

model HevyUserVerification {
  id               String                 @id @unique @default(cuid())
  lastCheck        DateTime?
  workoutId        String
  verificationCode String                 @unique
  status           UserVerificationStatus @default(pending)
  User             User                   @relation(fields: [userDiscordId], references: [discordId])
  userDiscordId    String
  userHevyUsername String

  createdAt DateTime @default(now())
}
